# Monday API credentials
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_BOARD_ID=your_monday_board_id_here

# Monday column IDs (replace with real column IDs from your board)
MONDAY_NAME_COLUMN_ID=name
MONDAY_EMAIL_COLUMN_ID=email
MONDAY_PHONE_COLUMN_ID=phone
MONDAY_PROSPECT_ID_COLUMN_ID=bonzo_prospect_id
MONDAY_STATUS_COLUMN_ID=status

# Bonzo webhook security (optional but recommended)
BONZO_WEBHOOK_SECRET=replace_with_shared_secret

# Server
PORT=3000
